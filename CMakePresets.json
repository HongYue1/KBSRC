{
  "version": 3,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release, tuned for this machine",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "KBSRC_ARCH": "native" }
    },
    {
      "name": "portable",
      "displayName": "Release, any CPU (AVX2 engine selected at run time on x86-64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/portable",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "KBSRC_ARCH": "portable" }
    },
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "portable", "configurePreset": "portable" },
    { "name": "debug", "configurePreset": "debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
